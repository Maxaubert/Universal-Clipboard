<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The agent's login item (plan 3.2). It lives in the app bundle
  (Contents/Library/LaunchAgents) and is registered with SMAppService.agent(plistName:)
  when the user turns on "Start at login". macOS drops it when the app is deleted (plan 8.5).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.maxaubert.uclip.agent</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/uc-agent</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>io.github.maxaubert.uclip</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
